{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 100,
      "type": "timeseries",
      "title": "错误日志趋势（5 分钟窗口计数）",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"app\"} | level=~\"(?i)error\" [5m]))",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 101,
      "type": "barchart",
      "title": "按 service 统计的 error 数",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({service=~\".+\"} | level=~\"(?i)error\" [5m]))",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 102,
      "type": "table",
      "title": "路由清单（点击行跳到对应时间段日志）",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (count_over_time({service=\"app\"} | level=~\"(?i)error\" [5m]))",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "links": [
        {
          "title": "查看该路由的日志",
          "type": "link",
          "url": "/d/loki-log-panels/loki-log-panels?${__url_time_range}&var-route=${__data.fields.route}"
        }
      ]
    },
    {
      "id": 103,
      "type": "logs",
      "title": "近期应用日志（全部 app 行）",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"app\"}",
          "queryType": "range",
          "editorMode": "code",
          "direction": "backward",
          "maxLines": 50,
          "limit": 50
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "logs",
      "title": "按 request_id 追踪：一次请求的全部日志行（AC1）",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"app\"} |= \"$request_id\"",
          "queryType": "range",
          "editorMode": "code",
          "direction": "backward",
          "maxLines": 50,
          "limit": 50
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 105,
      "type": "logs",
      "title": "按 route 查看（app-overview 点击跳转的落点）",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"app\"} |= \"$route\"",
          "queryType": "range",
          "editorMode": "code",
          "direction": "backward",
          "maxLines": 50,
          "limit": 50
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 106,
      "type": "logs",
      "title": "脱敏样本：手机号 / 身份证 / Bearer（AC2）",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"app\"} |= \"customer_phone\"",
          "queryType": "range",
          "editorMode": "code",
          "direction": "backward",
          "maxLines": 20,
          "limit": 20
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "refresh": "10s",
