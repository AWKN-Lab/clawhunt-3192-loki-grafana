# ── #3192 采集留存栈的可调变量（复制为 .env 后按需改；.env 不进仓）──────────
# 平台工单点名要求的三个变量：
#   log_retention_days    → LOG_RETENTION_DAYS      dev 租户默认留存天数（工单：7）
#   audit_retention_days  → AUDIT_RETENTION_DAYS    service=audit 审计日志留存天数（工单：365）
#   loki_storage_backend  → LOKI_STORAGE_BACKEND    块存储后端：local（本地数据盘）| s3（backups 桶 loki/ 前缀）
LOG_RETENTION_DAYS=7
TEST_RETENTION_DAYS=30
PROD_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
LOKI_STORAGE_BACKEND=local

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# 验收脚本用到的地址（默认就是本机端口，一般不用改）
LOKI_URL=http://127.0.0.1:3100
GRAFANA_URL=http://127.0.0.1:3000
LOKI_TENANT=dev
APP_URL=http://127.0.0.1:8080
GRAFANA_USERS_FILE=$HOME/.clawhunt/3192-grafana-users.env

# Loki 单次查询返回行数上限（工单要求 5000）
LOKI_MAX_ENTRIES_PER_QUERY=5000
